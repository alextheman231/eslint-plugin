{
  "name": "@alextheman/eslint-plugin",
  "version": "5.18.0",
  "description": "A package to provide custom ESLint rules and configs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alextheman231/eslint-plugin.git"
  },
  "license": "MIT",
  "author": "alextheman",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "import": "./dist/internal/index.js",
      "require": "./dist/internal/index.cjs",
      "default": "./dist/internal/index.js"
    },
    "./utility": {
      "types": "./dist/utility/index.d.ts",
      "import": "./dist/utility/index.js",
      "require": "./dist/utility/index.cjs",
      "default": "./dist/utility/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "build": "tsdown",
    "create-local-package": "pnpm run build && rm -f alextheman-eslint-plugin-*.tgz && pnpm pack",
    "create-release": "bash -c 'git pull origin main && alex-c-line template release-note create $@ --status \"Released\" --update-version' --",
    "create-release-note": "bash -c 'git pull origin main && alex-c-line template release-note create $@' --",
    "format": "pnpm run format-prettier && pnpm run format-eslint && pnpm run format-markdownlint",
    "format-and-build": "tsx src/utility/checkConfigChanges.ts || pnpm run build && pnpm run format",
    "format-eslint": "eslint --fix --suppress-all \"{src,tests}/**/*.ts\" \"package.json\" && rm -f eslint-suppressions.json",
    "format-markdownlint": "markdownlint-cli2 --fix \"**/*.md\" \"!{node_modules,dist}/**\" | grep -v \"^Finding:\"",
    "format-prettier": "pnpm run format-prettier-typescript && pnpm run format-prettier-javascript && pnpm run format-prettier-yml",
    "format-prettier-javascript": "prettier --write \"./**/*.js\"",
    "format-prettier-typescript": "prettier --write --parser typescript \"./**/*.ts\"",
    "format-prettier-yml": "prettier --write \"./**/*.{yml,yaml}\"",
    "lint": "pnpm run lint-tsc && pnpm run lint-eslint && pnpm run lint-markdownlint && pnpm run lint-prettier && pnpm run lint-pre-release",
    "lint-and-build": "tsx src/utility/checkConfigChanges.ts || pnpm run build && pnpm run lint",
    "lint-eslint": "eslint \"{src,tests}/**/*.ts\" \"package.json\"",
    "lint-markdownlint": "bash -o pipefail -c 'pnpm exec markdownlint-cli2 \"**/*.md\" \"!{node_modules,dist}/**\" | grep -v \"^Finding:\"'",
    "lint-pre-release": "alex-c-line package-json check --rules no-pre-release-dependencies",
    "lint-prettier": "pnpm run lint-prettier-typescript && pnpm run lint-prettier-javascript && pnpm run lint-prettier-yml",
    "lint-prettier-javascript": "prettier --check \"./**/*.js\"",
    "lint-prettier-typescript": "prettier --check --parser typescript \"./**/*.ts\"",
    "lint-prettier-yml": "prettier --check \"./**/*.{yml,yaml}\"",
    "lint-tsc": "tsc --noEmit",
    "pre-commit": "alex-c-line pre-commit",
    "prepare": "husky",
    "test": "vitest run",
    "test-end-to-end": "RUN_END_TO_END=true vitest run tests/end-to-end --reporter verbose",
    "test-watch": "vitest",
    "update-dependencies": "pnpm update --latest && pnpm update",
    "use-local-package": "bash -c 'alex-c-line use-local-package $@' --"
  },
  "dependencies": {
    "@alextheman/utility": "5.26.0",
    "@eslint/compat": "2.1.0",
    "@typescript-eslint/types": "8.65.0",
    "@typescript-eslint/utils": "8.65.0",
    "common-tags": "1.8.2",
    "prettier": "3.9.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint-react/eslint-plugin": "5.18.0",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/common-tags": "1.8.4",
    "@types/eslint": "9.6.1",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "26.1.1",
    "@typescript-eslint/rule-tester": "8.65.0",
    "alex-c-line": "2.13.0",
    "dotenv-cli": "11.0.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "63.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-n": "18.2.2",
    "eslint-plugin-package-json": "1.6.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-vitest-rule-tester": "3.1.0",
    "execa": "10.0.0",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "markdownlint-cli2": "0.23.1",
    "tempy": "3.2.0",
    "tsdown": "0.22.14",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint-react/eslint-plugin": ">=5.8.4",
    "@eslint/js": ">=9.0.0",
    "@stylistic/eslint-plugin": ">=5.10.0",
    "eslint": ">=9.0.0",
    "eslint-config-prettier": ">=10.0.0",
    "eslint-import-resolver-typescript": ">=4.4.4",
    "eslint-plugin-import-x": ">=4.16.2",
    "eslint-plugin-jsdoc": ">=61.5.0",
    "eslint-plugin-jsx-a11y-x": ">=0.2.0",
    "eslint-plugin-n": ">=17.23.1",
    "eslint-plugin-package-json": ">=0.85.0",
    "eslint-plugin-perfectionist": ">=5.0.0",
    "eslint-plugin-prettier": ">=5.0.0",
    "eslint-plugin-react-hooks": ">=7.0.0",
    "eslint-plugin-react-refresh": ">=0.4.0",
    "typescript-eslint": ">=8.0.0"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
